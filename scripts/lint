#!/usr/bin/env bash
# Run static checks.
#
#   scripts/lint        check only
#   scripts/lint --fix  apply safe fixes and format
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ "${1:-}" == "--fix" ]]; then
    uv run ruff check --fix .
    uv run ruff format .
else
    uv run ruff check .
    uv run ruff format --check .
fi

# tests are type-checked too. They are code, and a bug in a test is a bug --
# the `tests.*` override below relaxes the untyped-def rule for fixtures
# without exempting them from checking altogether.
uv run mypy api models worker scripts tests
