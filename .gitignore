# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.benchmarks/

# --- Secrets --------------------------------------------------------------
# .env holds real credentials and must never be committed.
# .env.example is the tracked template.
.env
.env.*
!.env.example
*.pem
*.key

# --- Data & model artifacts ----------------------------------------------
# Datasets and weights are large and reproducible from scripts; they are
# regenerated via `scripts/setup/download_datasets.py` and the training CLI.
# Anchored with a leading slash: an unanchored `data/` would also match the
# `models/data/` source package.
/data/
models/artifacts/*
!models/artifacts/.gitkeep
*.pth
*.pt
*.onnx
*.engine
*.plan
*.index

# Benchmark *reports* are committed (they are deliverables); raw traces are not.
benchmarks/raw/

# --- Local state ----------------------------------------------------------
.local/
/logs/
*.log
.DS_Store

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/
