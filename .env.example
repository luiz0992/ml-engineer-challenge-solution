# ---------------------------------------------------------------------------
# Template for local development. Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored. No real secret should ever appear in this file.
# In production these are injected by the orchestrator's secret store, not
# read from a file on disk.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console  (console is friendlier locally)

# --- Security -------------------------------------------------------------
# Generate with: openssl rand -hex 32
# The application refuses to start in production if this is left at the
# placeholder value; see api/config.py.
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=mlapi
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
POSTGRES_DB=mlapi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=3600

# --- Celery ---------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Model serving --------------------------------------------------------
ARTIFACTS_DIR=/app/models/artifacts
# torch | onnx | onnx-int8 | tensorrt
INFERENCE_BACKEND=onnx
# Fall back to a lower-priority backend if the preferred one fails to load.
ENABLE_GRACEFUL_DEGRADATION=true
# Allow callers to pin `?backend=onnx-int8` (or tensorrt). Off by default.
ALLOW_BACKEND_OVERRIDE=false

# --- Request limits -------------------------------------------------------
MAX_UPLOAD_BYTES=10485760     # 10 MiB
MAX_IMAGE_PIXELS=89478485     # Pillow decompression-bomb guard
MAX_BATCH_SIZE=64

# --- Rate limiting (requests per minute, per user tier) -------------------
RATE_LIMIT_FREE_RPM=10
RATE_LIMIT_PRO_RPM=120
RATE_LIMIT_ENTERPRISE_RPM=1200
